@define-color bg       #1a2035;
@define-color surface  #212d45;
@define-color surface2 #263350;
@define-color accent   #5b8dd9;
@define-color textcol  #e8eaf6;
@define-color subtext  #8899bb;
@define-color bordcol  #2e3f60;
@define-color selbg    #2e4880;
@define-color urgent   #e06c75;

* {
    background-color: transparent;
    text-color:       @textcol;
    font:             "JetBrains Mono 11";
}

window {
    width:            92%;
    height:           88%;
    background-color: @bg;
    border:           2px solid;
    border-color:     @bordcol;
    border-radius:    14px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
}

inputbar {
    background-color: @surface;
    border:           0px 0px 2px 0px;
    border-color:     @bordcol;
    border-radius:    14px 14px 0px 0px;
    padding:          14px 20px 14px 20px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: @accent;
    text-color:       @bg;
    padding:          4px 14px 4px 14px;
    border-radius:    6px;
    font:             "JetBrains Mono Bold 11";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @textcol;
    placeholder:       "Search wallpapers...";
    placeholder-color: @subtext;
    vertical-align:    0.5;
}

listview {
    background-color: transparent;
    padding:          18px 18px 18px 18px;
    spacing:          14px;
    columns:          4;
    lines:            99;
    scrollbar:        true;
    fixed-height:     false;
    layout:           vertical;
}

scrollbar {
    background-color: @surface2;
    handle-color:     @accent;
    handle-width:     5px;
    border-radius:    4px;
    width:            6px;
}

element {
    background-color: @surface2;
    border-radius:    10px;
    padding:          6px 6px 10px 6px;
    spacing:          0px;
    orientation:      vertical;
    border:           1px solid;
    border-color:     @bordcol;
}

element normal.normal {
    background-color: @surface2;
    text-color:       @subtext;
}

element selected.normal {
    background-color: @selbg;
    text-color:       @textcol;
    border-color:     @accent;
}

element alternate.normal {
    background-color: @surface2;
    text-color:       @subtext;
}

element normal.urgent {
    background-color: @surface2;
    text-color:       @urgent;
    border-color:     @urgent;
}

element selected.urgent {
    background-color: @selbg;
    text-color:       @urgent;
    border-color:     @urgent;
}

element-icon {
    background-color: #0d1525;
    size:             160px;
    border-radius:    7px 7px 0px 0px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       @subtext;
    font:             "JetBrains Mono 9";
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
