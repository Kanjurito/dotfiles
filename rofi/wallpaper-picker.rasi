* {
    background-color: transparent;
    text-color:       transparent;
    font:             "JetBrains Mono 1";
}

window {
    width:            96%;
    height:           94%;
    background-color: transparent;
    border:           0px;
    border-radius:    0px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
}

inputbar {
    background-color: transparent;
    border:           0px;
    padding:          6px 12px 6px 12px;
    spacing:          6px;
    children:         [ entry ];
}

entry {
    background-color:  transparent;
    text-color:        rgba(255,255,255,0.4);
    placeholder:       "";
    placeholder-color: transparent;
    vertical-align:    0.5;
    font:              "JetBrains Mono 10";
}

listview {
    background-color: transparent;
    padding:          8px 8px 8px 8px;
    spacing:          8px;
    columns:          5;
    lines:            99;
    scrollbar:        false;
    fixed-height:     false;
    layout:           vertical;
}

element {
    background-color: transparent;
    border-radius:    10px;
    padding:          0px;
    spacing:          0px;
    orientation:      vertical;
    border:           3px solid;
    border-color:     transparent;
}

element normal.normal {
    background-color: transparent;
    text-color:       transparent;
    border-color:     transparent;
}

element selected.normal {
    background-color: transparent;
    text-color:       transparent;
    border-color:     #4d9fff;
}

element alternate.normal {
    background-color: transparent;
    text-color:       transparent;
    border-color:     transparent;
}

element normal.urgent {
    background-color: transparent;
    text-color:       transparent;
    border-color:     transparent;
}

element selected.urgent {
    background-color: transparent;
    text-color:       transparent;
    border-color:     #e06c75;
}

element-icon {
    background-color: transparent;
    size:             220px;
    border-radius:    8px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       transparent;
    font:             "JetBrains Mono 1";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          0px;
}
