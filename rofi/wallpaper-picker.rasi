* {
    background-color: transparent;
    text-color:       #e8eaf6;
    font:             "JetBrains Mono 11";
}

window {
    width:            92%;
    height:           88%;
    background-color: #1a2035;
    border:           2px solid;
    border-color:     #2e3f60;
    border-radius:    14px;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          0px;
}

inputbar {
    background-color: #212d45;
    border:           0px 0px 2px 0px;
    border-color:     #2e3f60;
    border-radius:    14px 14px 0px 0px;
    padding:          14px 20px 14px 20px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: #5b8dd9;
    text-color:       #1a2035;
    padding:          4px 14px 4px 14px;
    border-radius:    6px;
    font:             "JetBrains Mono Bold 11";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        #e8eaf6;
    placeholder:       "Search wallpapers...";
    placeholder-color: #8899bb;
    vertical-align:    0.5;
}

listview {
    background-color: transparent;
    padding:          18px 18px 18px 18px;
    spacing:          14px;
    columns:          4;
    lines:            99;
    scrollbar:        true;
    fixed-height:     false;
    layout:           vertical;
}

scrollbar {
    background-color: #263350;
    handle-color:     #5b8dd9;
    handle-width:     5px;
    border-radius:    4px;
    width:            6px;
}

element {
    background-color: #263350;
    border-radius:    10px;
    padding:          6px 6px 10px 6px;
    spacing:          0px;
    orientation:      vertical;
    border:           1px solid;
    border-color:     #2e3f60;
}

element normal.normal {
    background-color: #263350;
    text-color:       #8899bb;
}

element selected.normal {
    background-color: #2e4880;
    text-color:       #e8eaf6;
    border-color:     #5b8dd9;
}

element alternate.normal {
    background-color: #263350;
    text-color:       #8899bb;
}

element normal.urgent {
    background-color: #263350;
    text-color:       #e06c75;
    border-color:     #e06c75;
}

element selected.urgent {
    background-color: #2e4880;
    text-color:       #e06c75;
    border-color:     #e06c75;
}

element-icon {
    background-color: #0d1525;
    size:             160px;
    border-radius:    7px 7px 0px 0px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       #8899bb;
    font:             "JetBrains Mono 9";
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
