# --- SWAYLOCK-EFFECTS CONFIGURATION ---
# Path: ~/dotfiles/swaylock/config

# Visual Effects: Take a screenshot of the desktop and apply blur/vignette
screenshots
effect-blur=9x5
effect-vignette=0.5:0.5
fade-in=0.15

# Behavior
ignore-empty-password
show-failed-attempts
daemonize

# --- INDICATOR & CLOCK ---
# Password ring dimensions
indicator-radius=55
indicator-thickness=5

# Enable and format Clock/Date
clock
timestr=%H:%M
datestr=%A %d %B

# Typography (Using JetBrainsMono Nerd Font)
font=JetBrainsMono Nerd Font
font-size=20
time-font=JetBrainsMono Nerd Font
date-font=JetBrainsMono Nerd Font
time-size=80
date-size=18

# --- CATPPUCCIN MOCHA COLORS ---

# Inner circle background colors (with transparency)
inside-color=1e1e2ecc
inside-clear-color=1e1e2ecc
inside-caps-lock-color=1e1e2ecc
inside-ver-color=1e1e2ecc
inside-wrong-color=1e1e2ecc

# Ring colors (Purple/Lavender theme)
ring-color=cba6f7aa       # Idle ring
ring-clear-color=a6e3a1ff # Green when cleared
ring-ver-color=89b4faff   # Blue when verifying
ring-wrong-color=f38ba8ff # Red when wrong password

# Border lines (set to transparent)
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

# Key press and Backspace highlights
key-hl-color=cba6f7ff
bs-hl-color=f38ba8ff

# Separator between ring and inside
separator-color=00000000

# Text colors for status and clock
text-color=cdd6f4ff
text-clear-color=a6e3a1ff
text-ver-color=89b4faff
text-wrong-color=f38ba8ff

time-color=cdd6f4ff
date-color=9399b2ff
